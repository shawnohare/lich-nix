#!/usr/bin/env bash
set -euo pipefail

# Build and verify the packaged Ruby runtime after a dependency change.
# Run from any directory; keep result pointing at the Saga launcher.
if [[ $# -ne 0 ]]; then
  echo "Usage: $0" >&2
  exit 2
fi
PROJECT_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
cd "$PROJECT_ROOT"

nix build .#saga-ruby
# Development gems need verification too, but must not replace result or
# create a second result symlink beside the launcher.
nix build --no-link .#lich-development-gems
# Includes the upstream Gemfile comparison and launcher regression tests:
# an empty home, stale Bundler settings, and native-library loading.
nix flake check
