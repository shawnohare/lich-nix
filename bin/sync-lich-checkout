#!/usr/bin/env bash
set -euo pipefail

# Create or switch a writable Lich clone to the commit in flake.lock.
# Use for initial setup or after update-lich-dependencies. Data stays in the clone;
# no files are cleaned/reset, and tracked local edits block the switch.
if [[ ${1:-} == --help || ${1:-} == -h ]]; then
  echo "Usage: $0"
  echo "Clone Lich if needed, then switch to the pinned commit, preserving application data."
  exit 0
fi
if [[ $# -gt 0 ]]; then
  echo "Usage: $0" >&2
  exit 2
fi
PROJECT_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
# Packaged source always lives below the shared project data root.
export LICHNIX_DATA_HOME="${LICHNIX_DATA_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/lichnix}"
checkout="$LICHNIX_DATA_HOME/packaged/lich-5"
# Resolve relative paths against the caller's directory before entering the repo.
if [[ $checkout != /* ]]; then
  checkout="$PWD/$checkout"
fi
cd "$PROJECT_ROOT"

# Git accepts a missing destination or an empty directory. Never clone over
# an existing nonempty directory: it may contain application data or another repo.
if [[ ! -e $checkout ]] || { [[ -d $checkout ]] && [[ -z $(ls -A "$checkout") ]]; }; then
  mkdir -p "$(dirname -- "$checkout")"
  git clone -- https://github.com/elanthia-online/lich-5.git "$checkout"
fi
checkout=$(CDPATH= cd -- "$checkout" && pwd -P)
if [[ $(git -C "$checkout" rev-parse --show-toplevel) != "$checkout" ]]; then
  echo "Expected the root of a Lich Git checkout: $checkout" >&2
  exit 1
fi
# Untracked scripts, databases, logs, and credentials are normal for Lich.
# Refuse tracked edits; git switch also refuses conflicting untracked files.
if ! git -C "$checkout" diff --quiet || ! git -C "$checkout" diff --cached --quiet; then
  echo "Commit or stash tracked changes in $checkout before switching releases." >&2
  exit 1
fi
lich_rev=$(nix eval --impure --raw --expr \
  '(builtins.getFlake (toString ./.)).inputs.lich-src.rev')
git -C "$checkout" fetch --tags
git -C "$checkout" switch --detach "$lich_rev"
echo "Lich checkout now matches $lich_rev. Verify Lich and Saga manually."
