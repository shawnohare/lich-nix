#!/usr/bin/env bash
set -euo pipefail

# Regenerate Nix metadata from the pinned upstream Gemfile and Gemfile.lock.
# Versions belong to upstream: bump inputs.lich-src to update dependencies.
if [[ ${1:-} == --help || ${1:-} == -h ]]; then
  echo "Usage: $0"
  echo "Regenerate gemset.nix from Lich's pinned lockfile, then build and verify."
  exit 0
fi
if [[ $# -ne 0 ]]; then
  echo "Usage: $0 (gem versions are pinned by upstream; update Lich instead)" >&2
  exit 2
fi
PROJECT_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
cd "$PROJECT_ROOT"

# Read the locked source, independently of the user's writable Lich checkout.
lich_source=$(nix eval --impure --raw --expr \
  '(builtins.getFlake (toString ./.)).inputs.lich-src.outPath')
nix develop .#gem-tools --command bundix \
  --gemfile="$lich_source/Gemfile" \
  --lockfile="$lich_source/Gemfile.lock" \
  --gemset="$PROJECT_ROOT/nix/gems/gemset.nix"

"$PROJECT_ROOT/bin/check-runtime"
echo "Review and commit nix/gems/gemset.nix."
